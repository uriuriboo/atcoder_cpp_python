      "\t\t\tdp[i + 1][j + 1] = min({dp[i][j + 1] + 1, dp[i + 1][j] + 1, dp[i][j] + (s[i] != t[j])});",
      "\t\t}",
      "\t}",
      "\treturn dp[n][m];",
      "}"
