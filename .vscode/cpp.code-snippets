      "using mint = atcoder::modint998244353;",
      "",
      "// nCr を mod 998244353 で求める。階乗とその逆元を O(n) で前計算し、1 回 O(1)",
      "// 使い方: Combination C(200000); C(5, 2).val() == 10",
      "struct Combination {",
      "\tvector<mint> fact, inv_fact;",
      "",
      "\tCombination(int n) : fact(n + 1), inv_fact(n + 1) {",
      "\t\tfact[0] = 1;",
      "\t\tfor (int i = 1; i <= n; i++) fact[i] = fact[i - 1] * i;",
      "\t\tinv_fact[n] = fact[n].inv();",
      "\t\tfor (int i = n; i > 0; i--) inv_fact[i - 1] = inv_fact[i] * i;",
      "\t}",
      "",
      "\tmint operator()(int n, int r) const {",
      "\t\tif (r < 0 || r > n) return 0;",
      "\t\treturn fact[n] * inv_fact[r] * inv_fact[n - r];",
      "\t}",
      "};"
