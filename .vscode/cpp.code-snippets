  "dijkstra": {
    "prefix": "fdijk",
    "body": [
      "// G[v] = {(行き先, 重み), ...}。頂点は 0 始まり",
      "using Graph = vector<vector<pair<int, ll>>>;",
      "",
      "// s から各頂点への最短距離。たどり着けない頂点は lINF。O((V + E) log V)",
      "vector<ll> dijkstra(int s, const Graph& G) {",
      "\tvector<ll> dist(G.size(), lINF);",
      "\tpriority_queue<pair<ll, int>, vector<pair<ll, int>>, greater<>> que;",
      "\tdist[s] = 0;",
      "\tque.emplace(0, s);",
      "\twhile (!que.empty()) {",
      "\t\tauto [d, v] = que.top();",
      "\t\tque.pop();",
      "\t\tif (d > dist[v]) continue;",
      "\t\tfor (auto [to, w] : G[v]) {",
      "\t\t\tif (chmin(dist[to], dist[v] + w)) que.emplace(dist[to], to);",
      "\t\t}",
      "\t}",
      "\treturn dist;",
      "}"
    ],
    "description": "ダイクストラ法の関数"
  },
