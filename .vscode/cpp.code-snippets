      "int editdistance(const string& s, const string& t) {",
      "\tint n = s.size(), m = t.size();",
      "\tvector dp(n + 1, vector<int>(m + 1));",
      "\tfor (int i = 0; i <= n; i++) dp[i][0] = i;",
