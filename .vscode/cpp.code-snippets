    "prefix": "lcsfunc",
    "body": [
      "// 最長共通部分列（LCS）。O(|A||B|)。dp[i][j] = A の先頭 i 文字と B の先頭 j 文字の LCS の長さ",
      "vector<vector<int>> lcs_table(const string& A, const string& B) {",
      "\tint a = A.size(), b = B.size();",
      "\tvector dp(a + 1, vector<int>(b + 1, 0));",
      "\tfor (int i = 0; i < a; i++) {",
      "\t\tfor (int j = 0; j < b; j++) {",
      "\t\t\tdp[i + 1][j + 1] = A[i] == B[j] ? dp[i][j] + 1 : max(dp[i + 1][j], dp[i][j + 1]);",
      "\t\t}",
      "\t}",
      "\treturn dp;",
      "}",
      "",
      "// LCS の長さ",
      "int lcs(const string& A, const string& B) { return lcs_table(A, B)[A.size()][B.size()]; }",
      "",
      "// LCS を 1 つ復元する",
      "string lcsmake(const string& A, const string& B) {",
      "\tauto dp = lcs_table(A, B);",
      "\tstring res;",
      "\tint i = A.size(), j = B.size();",
      "\twhile (i > 0 && j > 0) {",
      "\t\tif (dp[i][j] == dp[i][j - 1]) {",
      "\t\t\tj--;",
      "\t\t} else if (dp[i][j] == dp[i - 1][j]) {",
      "\t\t\ti--;",
      "\t\t} else {",
      "\t\t\tres += A[i - 1];",
      "\t\t\ti--, j--;",
      "\t\t}",
      "\t}",
      "\treverse(res.begin(), res.end());",
      "\treturn res;",
      "}"
    ],
    "description": "最長共通部分列（長さと復元）"
  },
