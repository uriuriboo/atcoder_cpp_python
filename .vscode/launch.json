{
    // どちらも input.txt を標準入力にする。書き換えずに使えるよう、問題には依存させていない
    "version": "0.2.0",
    "configurations": [
        {
            // 最後に build・build & test などでビルドした問題（build/debug/current）をデバッグする
            "name": "Debug C++",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/current",
            "args": [
                "<",
                "${workspaceFolder}/input.txt"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                // メモリリークを実行時エラーにしない（Dockerfile の ENV と同じ）
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            // 開いている .py（解答・gen.py・naive.py）をデバッグする。.py 以外を開いているときは、最後にビルドした .py の解答
            "name": "Debug Python",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venv/bin/python",
            "program": "${workspaceFolder}/scripts/debug_python.py",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal"
        }
    ]
}
