{
	// タスクはすべて scripts/ の Python を呼ぶ。${file}（開いているファイル）から、解いている問題を判定する
	// options.statusbar は拡張機能 actboy168.tasks の設定。よく使うタスクだけをステータスバーのボタンにする（hide: true は出さない）
	"version": "2.0.0",
	"tasks": [
		{
			"label": "new contest",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/new_contest.py",
				"${input:contest}"
			],
			"options": {
				"statusbar": {
					"label": "$(add) new contest",
					"detail": "コンテストの問題とサンプルを用意する"
				}
			},
			"problemMatcher": []
		},
		{
			"label": "build",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/build.py",
				"${file}"
			],
			"options": {
				"statusbar": {
					"hide": true
				}
			},
			"group": "build",
			"problemMatcher": "$gcc"
		},
		{
			"label": "build & test",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/test.py",
				"${file}"
			],
			"options": {
				"statusbar": {
					"label": "$(beaker) test",
					"detail": "build & test：ビルドしてサンプルでテストする（Ctrl+Shift+B）"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "build & test release",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/test.py",
				"--release",
				"${file}"
			],
			"options": {
				"statusbar": {
					"label": "$(dashboard) release",
					"detail": "build & test release：AtCoder と同じ最適化でテストする（実行時間の確認）"
				}
			},
			"group": "build",
			"problemMatcher": "$gcc"
		},
		{
			"label": "run (input.txt)",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/run.py",
				"${file}"
			],
			"options": {
				"statusbar": {
					"label": "$(play) run",
					"detail": "run (input.txt)：input.txt を入力にして実行する"
				}
			},
			"group": "build",
			"problemMatcher": "$gcc"
		},
		{
			"label": "submit",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/submit.py",
				"${file}"
			],
			"options": {
				"statusbar": {
					"label": "$(cloud-upload) submit",
					"detail": "サンプルでテストし、通ったら提出ページをブラウザで開く"
				}
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "stress: init",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/stress.py",
				"init",
				"${file}"
			],
			"options": {
				"statusbar": {
					"hide": true
				}
			},
			"problemMatcher": []
		},
		{
			"label": "stress: hack",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/stress.py",
				"hack",
				"${file}"
			],
			"options": {
				"statusbar": {
					"hide": true
				}
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "stress: test",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/stress.py",
				"test",
				"${file}"
			],
			"options": {
				"statusbar": {
					"hide": true
				}
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "visualize graph",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/visualize.py",
				"${workspaceFolder}/input.txt"
			],
			"options": {
				"statusbar": {
					"hide": true
				}
			},
			"problemMatcher": []
		},
		{
			"label": "visualize graph (directed)",
			"type": "shell",
			"command": "python3",
			"args": [
				"${workspaceFolder}/scripts/visualize.py",
				"${workspaceFolder}/input.txt",
				"--directed"
			],
			"options": {
				"statusbar": {
					"hide": true
				}
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "contest",
			"description": "コンテスト ID（abc325 など）か URL",
			"type": "promptString"
		}
	]
}
