// For format details, see https://aka.ms/devcontainer.json
{
	"name": "atcoder-cpp-py",
	// ツールをイメージのレイヤーにキャッシュするため Dockerfile を使う。requirements.txt を COPY するため、コンテキストはリポジトリ直下
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	// Windows ホストの bind mount はファイル I/O が遅いため、ビルド成果物（プリコンパイルヘッダを含む）は名前付きボリュームに置く
	"mounts": [
		"source=atcoder-cpp-py-build,target=${containerWorkspaceFolder}/build,type=volume"
	],
	// gdb と AddressSanitizer が ptrace を使うため
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined"
	],
	"postCreateCommand": "bash .devcontainer/postCreateCommand.bash",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				// Python。補完の Pylance とデバッガの debugpy も一緒に入る
				"ms-python.python",
				// Python のチェックと自動フォーマット
				"charliermarsh.ruff",
				// よく使うタスクをステータスバーのボタンにする（.vscode/tasks.json の options.statusbar）
				"actboy168.tasks"
			]
		}
	}
}
